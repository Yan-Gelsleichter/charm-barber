# Copie este arquivo para ".env" e preencha com os valores reais.
# Nunca coloque valores reais aqui neste arquivo (.env.example fica no Git).

# --- Supabase: usadas no navegador (build do frontend) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Supabase: usadas no servidor (agendamentos, pagamentos, webhooks) ---
# Precisam apontar para o MESMO projeto das variáveis VITE_ acima.
SB_URL=
SB_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=

# --- Mercado Pago: credencial de fallback a nível de aplicação ---
# Só é usada quando uma barbearia/barbeiro ainda não conectou a própria
# conta via OAuth. Precisam ser SEMPRE de produção (chaves "TEST-..." são
# rejeitadas em qualquer ambiente, não existe modo sandbox neste app).
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# --- Mercado Pago: OAuth (fluxo "Conectar Mercado Pago" no painel) ---
# Client ID/Secret da aplicação cadastrada no Painel de Desenvolvedores do
# Mercado Pago (developers.mercadopago.com > Suas integrações).
VITE_MP_CLIENT_ID=
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# --- Mercado Pago: assinatura secreta do webhook (produção) ---
# Copiada do Painel de Desenvolvedores > Sua aplicação > Webhooks.
# Usada como reserva quando a barbearia não tem uma secret própria salva
# no banco (coluna mp_webhook_secret).
MP_WEBHOOK_SECRET=

# --- App: URL pública usada em back_urls, notification_url e redirects ---
# Deve ser HTTPS e pública — localhost/domínios internos são recusados
# pelo Mercado Pago (sem isso, o app usa um domínio de produção fixo como
# fallback, o que não é útil para testar localmente).
APP_URL=

# Sobrescreve completamente a URL de notificação do webhook, se precisar
# de um valor diferente do calculado a partir de APP_URL (ex.: um túnel
# HTTPS temporário como ngrok, para testar localmente).
MP_NOTIFICATION_URL=

# --- Firebase: notificações push (navegador) ---
# Painel do Firebase > Configurações do projeto > Geral > Seus apps > app Web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Painel do Firebase > Configurações do projeto > Cloud Messaging > Certificados push da Web.
VITE_FIREBASE_VAPID_KEY=

# --- Firebase: notificações push (servidor, manda o aviso) ---
# Painel do Firebase > Configurações do projeto > Contas de serviço > Gerar
# nova chave privada — cole aqui o conteúdo INTEIRO do arquivo .json baixado,
# numa linha só. É secreto: nunca exponha no navegador.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Segredo simples que só a tarefa agendada (cron) da Vercel conhece, pra
# ninguém mais conseguir chamar a rota de lembretes de fora.
CRON_SECRET=

# --- App Android (Play Store) ---
# URL da ficha do app na Play Store. Enquanto vazia, o banner de "baixar
# app" em /b/{slug} não aparece (evita mostrar um botão sem destino antes
# do app existir).
VITE_PLAY_STORE_URL=
